.main-menu {
    width: 1920px;
    height: 1080px;
    background-image: url("project://database/Assets/Images/book_preview.png?fileID=2800000&guid=7bd8f3996c557f343aa3137bc85501e3&type=3#book_preview");
    -unity-background-scale-mode: scale-to-fit;
}

.sidebar {
    width: 300px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 150px 0 0 85px;
    padding-top: 200px;
}

.buttons {
    background-image: url("project://database/Assets/Images/WarmParchment.jpg?fileID=21300000&guid=8187f95de0683544f892789cf49d78e6&type=3#WarmParchment");
    width: 160px;
    height: 80px;
    font-size: 20px;
    -unity-font-definition: url("project://database/Assets/DefaceGames/fonts/Crimson-Bold.otf?fileID=12800000&guid=feb885b141d08e34b950775a3338bf34&type=3#Crimson-Bold");
    color: rgb(62, 40, 21);
    background-color: transparent;
    cursor: pointer;
    transition-duration: 0.35s;
    flex-shrink: 0;
    flex-grow: 0;
    margin-top: 10px;
    margin-right: 10px;
    margin-bottom: 10px;
    margin-left: 10px;
}

.buttons:hover {
    color: rgb(55, 36, 19);
    background-image: url("project://database/Assets/Images/Parchment.jpg?fileID=21300000&guid=bdbe4c05571c36146882d0da4d880216&type=3#Parchment");
}

.content-area {
    display: flex;
    flex-direction: column;
    gap: 10px;
    box-sizing: border-box;
    width: 580px;
    justify-content: flex-start;
    align-items: center;
    position: absolute;
    top: 12%;
    left: 18%;
    -unity-font-definition: url("project://database/Assets/DefaceGames/fonts/Crimson-Bold.otf?fileID=12800000&guid=feb885b141d08e34b950775a3338bf34&type=3#Crimson-Bold");
    padding-top: 50px;
}

.header {
    font-size: 40px;
    font-style: italic;
    margin: 0;
    -unity-font-definition: url("project://database/Assets/DefaceGames/fonts/Crimson-Bold.otf?fileID=12800000&guid=feb885b141d08e34b950775a3338bf34&type=3#Crimson-Bold");
    color: rgb(62, 40, 21);
    -unity-text-align: upper-center;
}

.flavor-text {
    font-size: 20px;
    line-height: 1.3;
    margin: 0;
    color: rgb(62, 40, 21);
    white-space: normal;
    -unity-font-definition: url("project://database/Assets/DefaceGames/fonts/Crimson-Bold.otf?fileID=12800000&guid=feb885b141d08e34b950775a3338bf34&type=3#Crimson-Bold");
}

.visuals-container {
    position: absolute;
    width: 350px;
    top: 12%;
    right: 23%;
}

.item {
    margin-bottom: 30px;
    font-weight: bold;
    font-size: 20px;
    display: flex;
    align-items: center;
    gap: 15px;
    margin-top: 30px;
    margin-right: 30px;
    margin-left: 30px;
}

.item-image {
    width: 250px;
    height: 150px;
    border-radius: 25px;
    border: 10px solid rgb(38, 29, 22);
    background-size: cover;
}

Slider {
    width: 100%;
    height: 30px;
    margin-top: 5px;
    margin-bottom: 5px;
}

Slider > .unity-slider__track {
    height: 6px;
    background-color: rgb(255, 180, 150);
    border-radius: 4px;
}

Slider > .unity-slider__dragger {
    height: 6px;
    background-color: rgb(230, 70, 70);
    border-radius: 4px;
}

Slider > .unity-slider__drag-container > .unity-drag-container > .unity-dragger {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background-color: rgb(200, 40, 40);
    border: 2px solid white;
    box-shadow: 0 0 4px rgba(0, 0, 0, 0.4);
    transition: background-color 0.2s ease;
}

Slider > .unity-slider__drag-container > .unity-drag-container > .unity-dragger:hover {
    background-color: rgb(255, 90, 90);
    cursor: pointer;
}
